<script type="text/javascript">
var nutSel = '';
$(document).on('click', '.nut-upssel', function(e) {
    e.preventDefault();
    nutSel = $(this).attr('data-ups');
    getNUTstatus();
});
function getNUTstatus() {
    if (nutSkipIfHidden('getNUTstatus', getNUTstatus, <?=$nut_poll_ms?>)) return;
    $.get('/plugins/nut-dw/include/nut_status.php', { all: 'true', ups: nutSel }, function(data) {
        if(data && data.success && data.success.response && data.success.allvars) {
            $('#nut_ups_all').html(data.success.upsrows || '');
            $('#nut_ups_wrap').toggle(!!data.success.upsrows);
            $('#nut_summary').html(data.success.response);
            $('#nut_status').html(data.success.allvars);
            $('#nut_status td:contains("ups.alarm")')
                .addClass('nut-alarm-cell')
                .next()
                .addClass('nut-alarm-cell nut-alarm-val');
            if(data.success.alarms) {
                $(".nutalarmrow").remove();
                let nutalarms = data.success.alarms;
                let nutalarmrows = "<tr class='nutalarmrow'><td colspan='7' class='red-text'><i class='fa fa-bell faa-ring animated'></i> <strong>Alarm:</strong> " + nutalarms.join("<br><i class='fa fa-bell faa-ring animated'></i> <strong>Alarm:</strong> ") + "</td></tr>";
                $('#nut_summary').append(nutalarmrows);
            } else {
                $(".nutalarmrow").remove();
            }
            if(typeof $.fn.tooltipster === 'function') {
                $('.tooltip-nutvar').tooltipster({
                    maxWidth: 300
                });
            }
        } else {
            $('#nut_summary').html('<tr><td colspan="7" class="nut-center"><i class="fa fa-times-circle red-text"></i> <em>Failed to retrieve information (check logs).</em></td></tr>');
            $('#nut_status').html('<tr><td colspan="4" class="nut-center"><i class="fa fa-times-circle red-text"></i> <em>Failed to retrieve information (check logs).</em></td></tr>');
        }
    }, 'json').always(function() {
        nutSchedule('getNUTstatus', getNUTstatus, <?=$nut_poll_ms?>);
    });
}
$(getNUTstatus);
</script>
