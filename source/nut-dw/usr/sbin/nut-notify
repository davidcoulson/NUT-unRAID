PLGPATH="/boot/config/plugins/nut-dw"
CONFIG="$PLGPATH/nut-dw.cfg"
NOTIFY="/usr/local/emhttp/plugins/dynamix/scripts/notify"
HOST="$(echo "$HOSTNAME" | awk '{print toupper($0)}')"
EVENT="UPS Status"

# shellcheck disable=SC2329
handle_term() {
    echo "has received a termination signal" | logger -t "nut-notify[$$]"
    exit 0
}

# shellcheck disable=SC2329
handle_end() {
    echo "is now exiting from handling ${NOTIFYTYPE:-UNKNOWN}" | logger -t "nut-notify[$$]"
}

trap handle_term SIGTERM SIGINT
trap handle_end EXIT

echo "is now handling ${NOTIFYTYPE:-UNKNOWN}" | logger -t "nut-notify[$$]"

# read our configuration
[ -e "$CONFIG" ] && source "$CONFIG"

# shellcheck disable=SC1091
[ -e "/etc/nut/xnut-notify-hooks.sh" ] && source "/etc/nut/xnut-notify-hooks.sh"

# upsmon passes the UPS that raised the event (name@host); fall back to the GUI setting
UPS="${UPSNAME:-${NAME}@${IPADDR}}"
SUBJECT="[${HOST}] NUT: [${UPS}] UPS"

if [ "$SHUTDOWN" == "batt_level" ]; then
    TIMER="$BATTERYLEVEL"
    MESSAGE="The system will shutdown when the UPS battery charge reaches ${BATTERYLEVEL}%."
    BATTERY="battery.charge"
fi

if [ "$SHUTDOWN" == "batt_timer" ]; then
    TIMER="$RTVALUE"
    MESSAGE="The system will shutdown when there is ${RTVALUE} ${RTUNIT} runtime left on the UPS battery."
    BATTERY="$RUNTIME"
fi

if [ "$SHUTDOWN" == "sec_timer" ]; then
    TIMER="$TIMEOUT"
    MESSAGE="The system will shutdown in ${TIMEOUT} seconds."
    BATTERY=""
fi

# On-battery debounce / EARLY_STAGE hook: upssched (config written by rc.nut, never in manual mode) times these.
# upsmon's NOTIFYCMD stays this script; for ONBATT/ONLINE it also feeds the event to upssched.
# Shutdown handling below is unaffected: only the wall/OS alert is held back (DELAYALERT=1) when upssched took the event.
[[ "$ONBATTDELAY" =~ ^[0-9]+$ ]] || ONBATTDELAY=0
[[ "$EARLYSTAGE" =~ ^[0-9]+$ ]] || EARLYSTAGE=0
DELAYALERT=0
if [ "$MANUAL" != "enable" ] && [ -n "$UPSNAME" ] && { [ "$ONBATTDELAY" -gt 0 ] || [ "$EARLYSTAGE" -gt 0 ]; } \
    && { [ "$NOTIFYTYPE" == "ONBATT" ] || [ "$NOTIFYTYPE" == "ONLINE" ]; }; then
    # no inherited pipes: upssched may leave a background daemon behind
    if timeout 15 /usr/sbin/upssched "$1" </dev/null >/dev/null 2>&1; then
        [ "$ONBATTDELAY" -gt 0 ] && DELAYALERT=1
    else
        echo "Error: upssched failed, sending alerts without delay..." | logger -t "nut-notify[$$]"
    fi
fi

if [ "$NOTIFYTYPE" == "ONLINE" ]
then
        echo "Terminating monitoring instances of the program for [${UPS}]..." | logger -t "nut-notify[$$]"
        for pid in $(pgrep -f "/usr/sbin/nut-notify"); do
            [ "$pid" == "$$" ] && continue
            # only cancel shutdowns started by the same UPS (no UPSNAME = legacy, cancel all)
            if [ -z "$UPSNAME" ] || tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -qxF "UPSNAME=${UPSNAME}"; then
                kill -s SIGTERM "$pid" 2>&1 | logger -t "nut-notify[$$]"
            fi
        done

        if [ "$DELAYALERT" == "1" ]; then
            echo "[${UPS}] UPS is online, any planned shutdowns were cancelled." | logger -t "nut-notify[$$]"
        else
            echo "[${UPS}] UPS is online, any planned shutdowns were cancelled." | tee >(wall) >(logger -t "nut-notify[$$]")
        fi

        if [ "$(type -t "ONLINE")" == "function" ]; then
            echo "Executing user's hook script for ONLINE (as non-blocking)..." | logger -t "nut-notify[$$]"
            ( ONLINE 2>&1 | logger -t "xnut-notify-hooks.sh[$$]" ) &
        fi

        # with a delayed alert, upssched's online command sends this only if the on-battery alert went out
        if [ "$DELAYALERT" != "1" ]; then
            echo "Sending OS notifications..." | logger -t "nut-notify[$$]"
            timeout -s9 15 "$NOTIFY" -e "${EVENT}" -s "Notice ${SUBJECT} On Line" -d "UPS is online, any planned shutdowns were cancelled." -i "normal"
            if [ $? -gt 100 ]; then
                echo "OS notifications could not be sent within 15 seconds." | logger -t "nut-notify[$$]"
            fi
        fi

elif [ "$NOTIFYTYPE" == "ONBATT" ]
then
        if [ "$SHUTDOWN" != "none" ] && [[ ! "$TIMER" =~ ^[0-9]+$ ]]; then
            SHUTDOWN="sec_timer"; TIMER=30; BATTERY=""
            MESSAGE="The system will shutdown in ${TIMER} seconds (due to malformed shutdown criteria set in GUI)."
            echo "Error: Malformed shutdown criteria, defaulting to ${TIMER} seconds timer..." | logger -t "nut-notify[$$]"
        fi

        # only the GUI-configured UPS drives the shutdown criteria; others are monitor-only here
        if [ -n "$UPSNAME" ] && [ "$UPSNAME" != "${NAME}@${IPADDR}" ]; then
            SHUTDOWN="none"
            MESSAGE="This is not the UPS configured for shutdown in the GUI ([${NAME}@${IPADDR}])."
        fi

        if [ "$DELAYALERT" == "1" ]; then
            echo "[${UPS}] UPS is on battery (alert delayed by ${ONBATTDELAY}s). ${MESSAGE}" | logger -t "nut-notify[$$]"
        else
            echo "[${UPS}] UPS is on battery. ${MESSAGE}" | tee >(wall) >(logger -t "nut-notify[$$]")
        fi

        if [ "$(type -t "ONBATT")" == "function" ]; then
            echo "Executing user's hook script for ONBATT (as non-blocking)..." | logger -t "nut-notify[$$]"
            ( ONBATT 2>&1 | logger -t "xnut-notify-hooks.sh[$$]" ) &
        fi

        if [ "$DELAYALERT" != "1" ]; then
            echo "Sending OS notifications..." | logger -t "nut-notify[$$]"
            timeout -s9 15 "$NOTIFY" -e "${EVENT}" -s "Alert ${SUBJECT} On Battery" -d "UPS is on battery. ${MESSAGE}" -i "alert"
            if [ $? -gt 100 ]; then
                echo "OS notifications could not be sent within 15 seconds." | logger -t "nut-notify[$$]"
            fi
        fi

        if [ "$SHUTDOWN" != "none" ]; then
            echo "Shutdown criteria are now being monitored..." | logger -t "nut-notify[$$]"

            if [ "$SHUTDOWN" == "sec_timer" ]; then
                (( n = TIMER ))
                # Loop with one second interval to allow SIGTERM reception.
                while [ $n -ne 0 ]
                do
                        sleep 1
                        (( n-- ))
                done
            else
                nodata=0
                timer=$(timeout 10 /usr/bin/upsc "$UPS" "$BATTERY" 2>/dev/null)
                # Loop with one second interval to allow SIGTERM reception.
                # Keep looping while above the threshold; on battery with no usable data for 120s, shut down anyway.
                while [ -z "$timer" ] || [[ ! "$timer" =~ ^[0-9]+([.][0-9]+)?$ ]] || [ "$(printf "%.0f" "$timer")" -gt "$TIMER" ]
                do
                    if [ -z "$timer" ] || [[ ! "$timer" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
                        (( nodata++ ))
                        if [ "$nodata" -ge 120 ]; then
                            echo "Error: No usable ${BATTERY} data from [${UPS}] for 120 seconds while on battery..." | logger -t "nut-notify[$$]"
                            break
                        fi
                    else
                        nodata=0
                    fi
                    sleep 1
                    timer=$(timeout 10 /usr/bin/upsc "$UPS" "$BATTERY" 2>/dev/null)
                done
            fi

            echo "Shutdown criteria are now met, proceeding with shutdown..." | logger -t "nut-notify[$$]"
            echo "[${UPS}] UNRAID is being gracefully shutdown from a UPS power event." | tee >(wall) >(logger -t "nut-notify[$$]")

            if [ "$(type -t "ONBATT_SHUTDOWN")" == "function" ]; then
                echo "Executing user's hook script for ONBATT_SHUTDOWN (as non-blocking)..." | logger -t "nut-notify[$$]"
                ( ONBATT_SHUTDOWN 2>&1 | logger -t "xnut-notify-hooks.sh[$$]" ) &
            fi

            echo "Sending OS notifications..." | logger -t "nut-notify[$$]"
            timeout -s9 15 "$NOTIFY" -e "${EVENT}" -s "Alert ${SUBJECT} System Shutdown" -d "UNRAID is being gracefully shutdown from a UPS power event." -i "alert"
            if [ $? -gt 100 ]; then
                echo "OS notifications could not be sent within 15 seconds." | logger -t "nut-notify[$$]"
            fi

            echo "Setting FSD (= point of no return)..." | logger -t "nut-notify[$$]"
            /usr/sbin/upsmon -c fsd
        fi

elif [ "$NOTIFYTYPE" == "REPLBATT" ]
then
        if [ "$REPLBATTMSG" == "enable" ]; then
            echo "[${UPS}] UPS reports that its batteries need replacement." | tee >(wall) >(logger -t "nut-notify[$$]")

            if [ "$(type -t "REPLBATT")" == "function" ]; then
                echo "Executing user's hook script for REPLBATT (as non-blocking)..." | logger -t "nut-notify[$$]"
                ( REPLBATT 2>&1 | logger -t "xnut-notify-hooks.sh[$$]" ) &
            fi

            echo "Sending OS notifications..." | logger -t "nut-notify[$$]"
            timeout -s9 15 "$NOTIFY" -e "${EVENT}" -s "Alert ${SUBJECT} Battery Replacement" -d "UPS reports that its batteries need replacement." -i "alert"
            if [ $? -gt 100 ]; then
                echo "OS notifications could not be sent within 15 seconds." | logger -t "nut-notify[$$]"
            fi
        fi

# for any other status messages the user has configured to be reported
else
        echo "[${UPS}] ${1}" | tee >(wall) >(logger -t "nut-notify[$$]")

        if [ "$(type -t "$NOTIFYTYPE")" == "function" ]; then
            echo "Executing user's hook script for $NOTIFYTYPE (as non-blocking)..." | logger -t "nut-notify[$$]"
            ( "$NOTIFYTYPE" 2>&1 | logger -t "xnut-notify-hooks.sh[$$]" ) &
        fi

        echo "Sending OS notifications..." | logger -t "nut-notify[$$]"
        # recovery events are informational, everything else (LOWBATT, FSD, COMMBAD, NOCOMM, ...) is an alert
        case "$NOTIFYTYPE" in COMMOK|NOTCAL|NOTBYPASS|NOTOFF|NOTOVER|NOTTRIM|NOTBOOST|NOTECO) LVL="normal" ;; *) LVL="alert" ;; esac
        timeout -s9 15 "$NOTIFY" -e "${EVENT}" -s "${LVL^} ${SUBJECT} Event ${NOTIFYTYPE}" -d "$1" -i "$LVL"
        if [ $? -gt 100 ]; then
            echo "OS notifications could not be sent within 15 seconds." | logger -t "nut-notify[$$]"
        fi
fi

exit 0
